NODE_ENV=development
LOG_LEVEL=debug
WEB_PORT=3000
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
WORKER_HEALTH_PORT=3002
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
AZURE_SQL_SERVER=localhost
AZURE_SQL_PORT=1433
AZURE_SQL_DATABASE=career_os
AZURE_SQL_USERNAME=sa
AZURE_SQL_PASSWORD=replace-with-a-local-password
DATABASE_HOST=localhost
DATABASE_PORT=1433
DATABASE_NAME=career_os
DATABASE_USER=sa
DATABASE_PASSWORD=replace-with-a-local-password
DATABASE_ENCRYPT=false
DATABASE_TRUST_SERVER_CERTIFICATE=true
JOBTECH_SEARCH_BASE_URL=https://jobsearch.api.jobtechdev.se
JOBTECH_STREAM_BASE_URL=https://jobstream.api.jobtechdev.se
JOBTECH_REQUEST_TIMEOUT_MS=5000
JOBTECH_MAX_RETRIES=2
JOBTECH_CACHE_TTL_SECONDS=60
OPENAI_REALTIME_MODEL=gpt-realtime
AUTH_ISSUER_URL=https://example.invalid/tenant/v2.0
AUTH_AUDIENCE=career-os-api
AUTH_MODE=local
AUTH_ISSUER=career-os-local
LOCAL_AUTH_SUBJECT=local-developer
AI_PROVIDER=fake
OPENAI_MODEL=gpt-5.4
# OPENAI_API_KEY is server-side only and intentionally has no example value.
ASSISTANT_MAX_TOOL_CALLS=8
ASSISTANT_TIMEOUT_MS=30000
ASSISTANT_CONTEXT_MESSAGE_LIMIT=30
ASSISTANT_CONFIRMATION_SECRET=replace-with-at-least-32-random-characters
CV_MAX_BYTES=5000000
CV_STORAGE_DIRECTORY=/tmp/career-os-cv
AUTH_JWKS_URL=https://example.invalid/.well-known/jwks.json
AUTH_ALLOWED_ALGORITHMS=RS256
